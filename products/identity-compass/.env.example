# ---- الموقع ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (المصادقة وقاعدة البيانات) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Claude (توليد سرد التقرير) ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5

# ---- Paddle (الدفع، تاجر السجل: يتكفل بالضريبة والفوترة) ----
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
NEXT_PUBLIC_PADDLE_PRICE_REPORT=pri_...
PADDLE_API_KEY=pdl_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# ---- فترة التجربة المفتوحة: true يفتح المنتج كاملاً مع مزايا بلس للجميع ويخفي الأسعار ----
NEXT_PUBLIC_BETA=true

# ---- وضع التجربة على الخادم فقط: true يفتح التقرير الكامل بلا دفع (للتطوير) ----
FREE_MODE=false

# للوضع المحلي بلا خادم: true يعرض التقرير الكامل في /results/local
NEXT_PUBLIC_FREE_MODE=false
